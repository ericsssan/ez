{
  "irVersion": 1,
  "name": "no-obj-calls",
  "category": "correctness",
  "description": "Disallow calling global object properties as functions",
  "fixable": null,
  "messages": {
    "unexpected": "'{callee}' is not a constructor."
  },
  "constants": {
    "allNonCallableGlobals": { "kind": "string-set", "values": ["Math", "JSON", "Reflect", "Atomics", "Intl"] },
    "es2015Globals": { "kind": "string-set", "values": ["Reflect", "Intl"] },
    "es2017Globals": { "kind": "string-set", "values": ["Atomics"] }
  },
  "handlers": [
    {
      "kind": "for-each-unresolved-global-ref",
      "selector": "Identifier",
      "namesConstant": "allNonCallableGlobals",
      "refIdentifierBinding": "__ref_identifier__",
      "body": [
        {
          "op": "if",
          "cond": {
            "op": "binary", "operator": "&&",
            "lhs": { "op": "set-contains", "setName": "es2015Globals", "value": { "op": "identifier", "name": "__name__" } },
            "rhs": {
              "op": "binary", "operator": "&&",
              "lhs": { "op": "binary", "operator": "<", "lhs": { "op": "get-ecma-version" }, "rhs": { "op": "literal", "value": 2015 } },
              "rhs": { "op": "unary", "operator": "!", "operand": { "op": "global-is-explicitly-enabled" } }
            }
          },
          "then": [{ "op": "return" }]
        },
        {
          "op": "if",
          "cond": {
            "op": "binary", "operator": "&&",
            "lhs": { "op": "set-contains", "setName": "es2017Globals", "value": { "op": "identifier", "name": "__name__" } },
            "rhs": {
              "op": "binary", "operator": "&&",
              "lhs": { "op": "binary", "operator": "<", "lhs": { "op": "get-ecma-version" }, "rhs": { "op": "literal", "value": 2017 } },
              "rhs": { "op": "unary", "operator": "!", "operand": { "op": "global-is-explicitly-enabled" } }
            }
          },
          "then": [{ "op": "return" }]
        },
        {
          "op": "if",
          "cond": {
            "op": "binary", "operator": "&&",
            "lhs": {
              "op": "binary", "operator": "||",
              "lhs": { "op": "node-tag-equals", "estreeType": "CallExpression", "node": { "op": "parent-node-skip-grouping", "node": { "op": "identifier", "name": "__ref_identifier__" } } },
              "rhs": { "op": "node-tag-equals", "estreeType": "NewExpression", "node": { "op": "parent-node-skip-grouping", "node": { "op": "identifier", "name": "__ref_identifier__" } } }
            },
            "rhs": {
              "op": "nodes-equal",
              "a": { "op": "node-callee", "node": { "op": "parent-node-skip-grouping", "node": { "op": "identifier", "name": "__ref_identifier__" } } },
              "b": { "op": "identifier", "name": "__ref_identifier__" }
            }
          },
          "then": [
            { "op": "report", "node": { "op": "parent-node-skip-grouping", "node": { "op": "identifier", "name": "__ref_identifier__" } }, "messageId": "unexpected" }
          ]
        }
      ]
    }
  ]
}
