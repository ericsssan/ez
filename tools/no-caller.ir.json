            "rhs": {
              "op": "set-contains",
              "setName": "__rx_0__",
              "value": {
                "op": "member",
                "object": {
                  "op": "node-secondary-child",
                  "node": {
                    "op": "node-ref"
                  }
                },
                "property": "name",
                "computed": false
              }
            }
