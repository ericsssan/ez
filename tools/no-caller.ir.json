{
  "name": "no-caller",
  "category": "style",
  "description": "Disallow the use of `arguments.caller` or `arguments.callee`",
  "fixable": null,
  "messages": {
    "unexpected": "Avoid arguments.{{prop}}."
  },
  "constants": {
