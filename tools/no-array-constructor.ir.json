{
  "irVersion": 1,
  "name": "no-array-constructor",
  "category": "style",
  "description": "Disallow use of the Array constructor",
  "fixable": null,
  "messages": {
    "preferLiteral": "The array literal notation [] is preferable."
  },
  "constants": {
    "arrayBuiltin": { "kind": "string-set", "values": ["Array"] }
  },
  "handlers": [
    {
      "kind": "for-each-unresolved-global-ref",
      "selector": "Identifier",
      "namesConstant": "arrayBuiltin",
      "refIdentifierBinding": "__ref_identifier__",
      "body": [
        {
          "op": "if",
          "cond": {
            "op": "binary", "operator": "&&",
            "lhs": {
              "op": "binary", "operator": "||",
              "lhs": { "op": "node-tag-equals", "estreeType": "NewExpression",
                "node": { "op": "parent-node-skip-grouping", "node": { "op": "identifier", "name": "__ref_identifier__" } } },
              "rhs": { "op": "node-tag-equals", "estreeType": "CallExpression",
                "node": { "op": "parent-node-skip-grouping", "node": { "op": "identifier", "name": "__ref_identifier__" } } }
            },
            "rhs": { "op": "nodes-equal",
              "a": { "op": "node-callee", "node": { "op": "parent-node-skip-grouping", "node": { "op": "identifier", "name": "__ref_identifier__" } } },
              "b": { "op": "identifier", "name": "__ref_identifier__" }
            }
          },
          "then": [
            {
              "op": "if",
              "cond": {
                "op": "binary", "operator": "||",
                "lhs": {
                  "op": "binary", "operator": "||",
                  "lhs": { "op": "unary", "operator": "!", "operand": { "op": "node-arg-at", "node": { "op": "parent-node-skip-grouping", "node": { "op": "identifier", "name": "__ref_identifier__" } }, "index": 0 } },
                  "rhs": { "op": "node-arg-at", "node": { "op": "parent-node-skip-grouping", "node": { "op": "identifier", "name": "__ref_identifier__" } }, "index": 1 }
                },
                "rhs": {
                  "op": "node-tag-equals", "estreeType": "SpreadElement",
                  "node": { "op": "node-arg-at", "node": { "op": "parent-node-skip-grouping", "node": { "op": "identifier", "name": "__ref_identifier__" } }, "index": 0 }
                }
              },
              "then": [
                {
                  "op": "if",
                  "cond": { "op": "node-tag-equals", "estreeType": "NewExpression",
                    "node": { "op": "parent-node-skip-grouping", "node": { "op": "identifier", "name": "__ref_identifier__" } } },
                  "then": [
                    { "op": "report", "node": { "op": "parent-node-skip-grouping", "node": { "op": "identifier", "name": "__ref_identifier__" } }, "messageId": "preferLiteral" }
                  ],
                  "else": [
                    { "op": "report", "node": { "op": "identifier", "name": "__ref_identifier__" }, "messageId": "preferLiteral" }
                  ]
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
