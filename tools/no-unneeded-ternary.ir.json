{
  "name": "no-unneeded-ternary",
  "category": "style",
  "description": "Disallow ternary operators when simpler alternatives exist",
  "fixable": "code",
  "messages": {
    "unnecessaryConditionalExpression": "Unnecessary use of boolean literals in conditional expression.",
    "unnecessaryConditionalAssignment": "Unnecessary use of conditional expression for default assignment."
  },
  "constants": {
    "BOOLEAN_OPERATORS": {
      "kind": "string-set",
      "values": [
        "==",
        "===",
        "!=",
        "!==",
        ">",
        ">=",
        "<",
        "<=",
        "in",
        "instanceof"
      ]
    }
  },
  "handlers": [
    {
      "selector": "ConditionalExpression",
      "body": [
        {
          "op": "if",
          "cond": {
            "op": "binary",
            "operator": "&&",
            "lhs": {
              "op": "binary",
              "operator": "&&",
              "lhs": {
                "op": "node-tag-equals",
                "node": {
                  "op": "conditional-alternate",
                  "node": {
                    "op": "node-ref"
                  }
                },
                "estreeType": "Literal"
              },
              "rhs": {
                "op": "node-tag-equals",
                "node": {
                  "op": "conditional-alternate",
                  "node": {
                    "op": "node-ref"
                  }
                },
                "estreeType": "__TypeofBoolean__"
              }
            },
            "rhs": {
              "op": "binary",
              "operator": "&&",
              "lhs": {
                "op": "node-tag-equals",
                "node": {
                  "op": "conditional-consequent",
                  "node": {
                    "op": "node-ref"
                  }
                },
                "estreeType": "Literal"
              },
              "rhs": {
                "op": "node-tag-equals",
                "node": {
                  "op": "conditional-consequent",
                  "node": {
                    "op": "node-ref"
                  }
                },
                "estreeType": "__TypeofBoolean__"
              }
            }
          },
          "then": [
            {
              "op": "report",
              "node": {
                "op": "node-ref"
              },
              "messageId": "unnecessaryConditionalExpression"
            }
          ],
          "else": [
            {
              "op": "if",
              "cond": {
                "op": "binary",
                "operator": "&&",
                "lhs": {
                  "op": "unary",
                  "operator": "!",
                  "operand": {
                    "op": "get-option-bool",
                    "name": "defaultAssignment",
                    "default": true
                  }
                },
                "rhs": {
                  "op": "binary",
                  "operator": "&&",
                  "lhs": {
                    "op": "binary",
                    "operator": "&&",
                    "lhs": {
                      "op": "node-tag-equals",
                      "node": {
                        "op": "conditional-test",
                        "node": {
                          "op": "node-ref"
                        }
                      },
                      "estreeType": "Identifier"
                    },
                    "rhs": {
                      "op": "node-tag-equals",
                      "node": {
                        "op": "conditional-consequent",
                        "node": {
                          "op": "node-ref"
                        }
                      },
                      "estreeType": "Identifier"
                    }
                  },
                  "rhs": {
                    "op": "binary",
                    "operator": "===",
                    "lhs": {
                      "op": "member",
                      "object": {
                        "op": "conditional-test",
                        "node": {
                          "op": "node-ref"
                        }
                      },
                      "property": "name",
                      "computed": false
                    },
                    "rhs": {
                      "op": "member",
                      "object": {
                        "op": "conditional-consequent",
                        "node": {
                          "op": "node-ref"
                        }
                      },
                      "property": "name",
                      "computed": false
                    }
                  }
                }
              },
              "then": [
                {
                  "op": "report",
                  "node": {
                    "op": "node-ref"
                  },
                  "messageId": "unnecessaryConditionalAssignment"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
