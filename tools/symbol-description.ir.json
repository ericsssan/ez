{
  "name": "symbol-description",
  "category": "style",
  "description": "Require symbol descriptions",
  "fixable": null,
  "messages": {
    "expected": "Expected Symbol to have a description."
  },
  "constants": {
    "__Symbol_names__": {
      "kind": "string-array",
      "values": [
        "Symbol"
      ]
    }
  },
  "helpers": {
    "checkArgument": {
      "kind": "report-if",
      "param": "node",
      "cond": {
        "op": "node-args-length-zero",
        "node": {
          "op": "node-ref"
        }
      },
      "messageId": "expected"
    }
  },
  "handlers": [
    {
      "selector": "Program:exit",
      "kind": "for-each-unresolved-global-ref",
      "namesConstant": "__Symbol_names__",
      "refIdentifierBinding": "__ref_identifier__",
      "body": [
        {
          "op": "if",
          "cond": {
            "op": "binary",
            "operator": "&&",
            "lhs": {
              "op": "node-tag-equals",
              "node": {
                "op": "parent-node",
                "node": {
                  "op": "identifier",
                  "name": "__ref_identifier__"
                }
              },
              "estreeType": "CallExpression"
            },
            "rhs": {
              "op": "nodes-equal",
              "a": {
                "op": "node-main-child",
                "node": {
                  "op": "parent-node",
                  "node": {
                    "op": "identifier",
                    "name": "__ref_identifier__"
                  }
                }
              },
              "b": {
                "op": "identifier",
                "name": "__ref_identifier__"
              }
            }
          },
          "then": [
            {
              "op": "if",
              "cond": {
                "op": "node-args-length-zero",
                "node": {
                  "op": "parent-node",
                  "node": {
                    "op": "identifier",
                    "name": "__ref_identifier__"
                  }
                }
              },
              "then": [
                {
                  "op": "report",
                  "node": {
                    "op": "parent-node",
                    "node": {
                      "op": "identifier",
                      "name": "__ref_identifier__"
                    }
                  },
                  "messageId": "expected"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
