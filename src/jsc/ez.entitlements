<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Required to JIT-compile JS in Apple's JavaScriptCore.framework.
         macOS's hardened runtime W^X enforcement otherwise blocks
         JIT code-page allocation, falling JSC back to LLInt interpreter
         (~10-30× slower for hot code).

         For distribution we'd vendor WebKit JSC built from source instead
         (avoids the entitlement coupling); during development this is the
         5-line way to unlock JIT performance.
    -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-executable-page-protection</key>
    <true/>
</dict>
</plist>
